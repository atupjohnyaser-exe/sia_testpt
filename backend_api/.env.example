APP_NAME="Rockport Records"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=rockport_records
DB_USERNAME=root
DB_PASSWORD=

# API only, no browser sessions are used
SESSION_DRIVER=array
CACHE_STORE=database
QUEUE_CONNECTION=database

# Comma separated list of allowed frontend origins
FRONTEND_URL=http://localhost:5173

# Security. Demo mode must stay false anywhere real people can reach the API.
APP_DEMO_MODE=false
DEMO_DEFAULT_CLEARANCE=2
TOKEN_TTL_MINUTES=480

# Password for the seeded demo officers. In local env it falls back to demo1234.
# In production the officer seeder refuses to run without it.
SEED_OFFICER_PASSWORD=
